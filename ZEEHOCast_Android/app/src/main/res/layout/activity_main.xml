<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- 品牌区 -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZEEHO CAST"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="极核仪表投屏 · AE5i"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Tab 切换 -->
    <LinearLayout
        android:id="@+id/tabRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_tabrow"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="22dp">

        <TextView
            android:id="@+id/tabDiscover"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/tab_discover"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/bg_tab"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tabQr"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/tab_qr"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/bg_tab"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tabManual"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/tab_manual"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:background="@drawable/bg_tab"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- ============ 面板1：自动发现 ============ -->
    <LinearLayout
        android:id="@+id/panelDiscover"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/tabRow"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="可用仪表"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="@string/btn_refresh"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:background="@drawable/bg_btn_ghost"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDevices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="gone"
            android:text="@string/empty_devices"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_searching"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- ============ 面板2：扫码 ============ -->
    <LinearLayout
        android:id="@+id/panelQr"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="扫描仪表上的二维码快速连接"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnQrScan"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="扫描二维码"
            android:textColor="@color/accent"
            android:textSize="16sp"
            android:background="@drawable/bg_qr"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="16dp" />
    </LinearLayout>

    <!-- ============ 面板3：手动 ============ -->
    <LinearLayout
        android:id="@+id/panelManual"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tabRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_ip"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etIp"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/hint_ip"
            android:inputType="text"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_port"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="14dp" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/hint_port"
            android:inputType="number"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="@string/btn_connect"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="20dp" />
    </LinearLayout>

    <!-- 底部：免责 + 日志 -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvDisclaimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/btnExportLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_log"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
